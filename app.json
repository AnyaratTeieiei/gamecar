{
  "expo": {
    "name": "Neon Drive",
    "slug": "neon-drive-sensor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1217",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neondrive.sensorlab",
      "infoPlist": {
        "NSMotionUsageDescription": "Use device motion to steer and display live sensor readings while driving."
      }
    },
    "android": {
      "package": "com.neondrive.sensorlab",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Neon Drive to use device motion for steering."
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
